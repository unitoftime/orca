#!/bin/sh
#
# Managed by orca — do not edit by hand.
# Rendered from cmd/orca/templates/host/docker-credential-orca.
#
# The Docker credential helper Nomad asks before every image pull
# (plugin "docker" { auth { helper = "orca" } } in nomad.hcl). Docker's helper
# protocol: `get` with a registry host on stdin, answered with
# {"Username": ..., "Secret": ...} on stdout.
#
# The answer comes from Nomad's variable store, where `orca registry login`
# puts it: the same store every other orca secret lives in, so a registry
# token is never in a job spec, a container's environment or a file on disk.
# The API answers on loopback on every machine, and a machine running no
# server forwards the read to one.
#
# It never fails. Nomad treats a helper that exits non-zero as a failed pull,
# so a failure here would break every public image as well. A registry with
# no credentials (or a store that cannot be reached) is answered with {},
# which Nomad takes as "pull anonymously": a public image still pulls, and a
# private one fails as unauthorized, which is the true reason.

# store, erase and list are for `docker login`. Credentials are set with
# `orca registry login`, never through this helper.
[ "$1" = "get" ] || exit 0

# Only characters a registry host can hold, so nothing read here reaches the
# URL but a host. "." and ":" become "_" and "~" because Nomad refuses them in
# a variable path; deploy.RegistryPath does the same substitution.
KEY=$(tr 'A-Z' 'a-z' | tr -cd 'a-z0-9.:-' | tr '.:' '_~')

if [ -n "$KEY" ] \
  && VAR=$(curl -sf --max-time 5 "{{NOMAD_ADDR}}/v1/var/{{REGISTRY_PREFIX}}/${KEY}") \
  && OUT=$(printf '%s' "$VAR" | jq -ce '{Username: .Items.username, Secret: .Items.password}') ; then
  printf '%s\n' "$OUT"
else
  echo '{}'
fi
exit 0
